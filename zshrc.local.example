# Example ~/.zshrc.local — copy to ~/.zshrc.local (NOT tracked; it is in .gitignore),
# chmod 600, uncomment what you need, and replace the placeholder values.
# Sourced at the end of ~/.zshrc. Every value below is a fake placeholder.

# --- Claude Code ---
# export CLAUDE_CODE_OAUTH_TOKEN="<your-claude-oauth-token>"

# --- GitHub ---
# export GITHUB_TOKEN="<your-github-personal-access-token>"

# --- Proxmox VE (API token auth) ---
# export PROXMOX_VE_ENDPOINT="https://<proxmox-host>:8006/"
# export PROXMOX_VE_API_TOKEN="<user>@<realm>!<token-id>=<token-secret>"
# export PROXMOX_VE_INSECURE="false"

# --- Git hosts (Gitea / Forgejo) ---
# export GITEA_HOST="git.example.com"
# export GITEA_USERNAME="<your-username>"
# export GITEA_TOKEN="<your-gitea-token>"
# export FORGEJO_HOST="git.example.org"
# export FORGEJO_USERNAME="<your-username>"
# export FORGEJO_TOKEN="<your-forgejo-token>"

# --- Ollama (self-hosted; OLLAMA_HOST needs the scheme and no trailing slash) ---
# export OLLAMA_HOST="http://<ollama-host>:11434"
# export OLLAMA_TOKEN="<bearer-token-if-proxied>"

# --- Model providers used by OpenCode ---
# export OPENROUTER_API_KEY="<your-openrouter-key>"
# export ZHIPU_API_KEY="<your-zai-coding-plan-key>"   # provider id: zai-coding-plan
# export ANTHROPIC_API_KEY="<your-anthropic-key>"     # or run `opencode auth login`

# --- Anything else ---
# export SOME_SERVICE_API_KEY="<your-api-key>"

# NOTE: in a Coder workspace these arrive via ~/.config/coder/secrets.env, which
# the template writes from its own template variables -- this file isn't needed there.

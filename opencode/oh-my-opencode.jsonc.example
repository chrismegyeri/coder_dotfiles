// Example ~/.config/opencode/oh-my-opencode.json (JSONC: comments are allowed).
//
// oh-my-opencode works out of the box and picks sensible models for each of its
// agents, so this file is OPTIONAL -- only add it when you want to pin specific
// agents to specific models. Copy it to ~/.config/opencode/oh-my-opencode.json
// (or .opencode/oh-my-opencode.json inside a project) and uncomment what you need.
//
// Model ids are "<provider>/<model>". The providers available in a Coder
// workspace from this dotfiles repo:
//   zai-coding-plan/...  -- needs ZHIPU_API_KEY   (Z.AI coding plan)
//   openrouter/...       -- needs OPENROUTER_API_KEY
//   ollama/...           -- needs OLLAMA_HOST (models are discovered at install)
//   anthropic/...        -- needs `opencode auth login` or ANTHROPIC_API_KEY
// Run `opencode` then `/models` to see exactly what resolved.
{
  // "agents": {
  //   "sisyphus":          { "model": "zai-coding-plan/glm-4.7" },
  //   "oracle":            { "model": "openrouter/openai/gpt-5.2" },
  //   "explore":           { "model": "zai-coding-plan/glm-4.7-flash" },
  //   "librarian":         { "model": "zai-coding-plan/glm-4.7" },
  //   "multimodal-looker": { "model": "openrouter/google/gemini-3-pro" }
  // }
}

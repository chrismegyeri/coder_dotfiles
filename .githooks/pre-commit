#!/usr/bin/env bash
# Refuse to commit anything that looks like a credential.
# Enable once per clone:  git config core.hooksPath .githooks
#
# This repo is public and is cloned into every Coder workspace, so tokens must
# never land here. Real secrets belong in ~/.zshrc.local or (in Coder)
# ~/.config/coder/secrets.env, which the template writes from template variables.
set -u

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

# Patterns: provider key prefixes, Proxmox tokens, PEM blocks, and any
# assignment of a *_TOKEN/_KEY/_SECRET/PASSWORD to a non-placeholder value.
patterns='
sk-ant-[A-Za-z0-9_-]{10,}
sk-or-v1-[A-Za-z0-9]{10,}
ghp_[A-Za-z0-9]{20,}
gho_[A-Za-z0-9]{20,}
github_pat_[A-Za-z0-9_]{20,}
BEGIN [A-Z ]*PRIVATE KEY
[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+![A-Za-z0-9_-]+=[0-9a-f]{8}-[0-9a-f]{4}
(TOKEN|API_KEY|APIKEY|SECRET|PASSWORD)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{16,}
'

fail=0
while IFS= read -r f; do
  case "$f" in
    *.example|*.md|.githooks/pre-commit) continue ;;
  esac
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if hits=$(git show ":$f" 2>/dev/null | grep -nEI "$p"); then
      # Ignore obvious placeholders.
      hits=$(printf '%s\n' "$hits" | grep -viE '<[^>]*>|your-|example|placeholder|xxx+|\{env:|\$\{|changeme|fake' || true)
      [ -n "$hits" ] || continue
      [ "$fail" -eq 0 ] && echo "pre-commit: possible credential(s) staged -- commit blocked" >&2
      fail=1
      printf '  %s: %s\n' "$f" "$hits" >&2
    fi
  done <<EOF
$patterns
EOF
done <<EOF
$staged
EOF

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

Move the value to ~/.zshrc.local (untracked) or, for Coder workspaces, to a
template variable in Coder (Template -> Settings -> Variables); the template
writes it to ~/.config/coder/secrets.env at workspace start.
Override only if this is a false positive:  git commit --no-verify
MSG
  exit 1
fi
exit 0
